# Copy this file to keystore.properties and fill in your values.
# NEVER commit keystore.properties — it is in .gitignore.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore cacree-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias cacree
storeFile=../cacree-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=cacree
keyPassword=YOUR_KEY_PASSWORD
